# Server Configuration
PORT=5000

# MongoDB Configuration (Local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/actionflow
# For MongoDB Atlas, use:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/actionflow?retryWrites=true&w=majority

# Firebase Admin SDK Configuration
# Option A: Environment variables
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Option B: Path to Service Account JSON file
# FIREBASE_SERVICE_ACCOUNT_KEY=./firebase-service-account.json
